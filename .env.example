# Copy this file to .env and fill in real values.
# Public site address (no trailing slash). Used for canonical URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=https://your-domain.com
# Public contact email shown on the Contact page.
VITE_CONTACT_EMAIL=hello@your-domain.com
# Leave EMPTY until Google approves your AdSense account (Phase 7). Format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT=
# Ad-unit ID of the ad shown at the bottom of tool pages (from AdSense > Ads > By ad unit).
VITE_ADSENSE_SLOT_TOOL_BOTTOM=
# Set to true before applying for AdSense to hide every "Coming soon" tool (they then 404 and leave the sitemap).
VITE_HIDE_UNFINISHED=false
